# Copia este archivo a .env y llena los valores. Nunca subas .env a GitHub.

# Base de la bitácora (esquema propio en tu instancia de Amazon RDS MySQL).
# Para conexión cifrada agrega &ssl_ca=/etc/ssl/certs/rds-global-bundle.pem (ver README).
DATABASE_URL=mysql+pymysql://bitacora_app:CAMBIA_ESTO@TU_ENDPOINT.rds.amazonaws.com:3306/bitacora_mci?charset=utf8mb4

# Base de CFDI (solo lectura). Usa un usuario MySQL con permiso SELECT únicamente.
CFDI_DATABASE_URL=mysql+pymysql://cfdi_lectura:CAMBIA_ESTO@TU_ENDPOINT.rds.amazonaws.com:3306/cfdi?charset=utf8mb4
# Consulta que devuelve las facturas de venta entre :desde y :hasta (fechas AAAA-MM-DD).
# Debe regresar estas columnas con estos alias: fecha, uuid, rfc_receptor, nombre_receptor,
# subtotal, moneda, tipo_cambio. Ajusta tablas y campos a tu esquema real.
CFDI_VENTAS_SQL="SELECT fecha_emision AS fecha, uuid, rfc_receptor, nombre_receptor, subtotal, moneda, tipo_cambio FROM comprobantes WHERE tipo_comprobante='I' AND estatus='Vigente' AND rfc_emisor='TU_RFC' AND fecha_emision >= :desde AND fecha_emision < :hasta"

# Estatus de clientes (recurrente / baja) de Panel AYF. Columnas: rfc, es_recurrente, es_baja, fecha_baja
CFDI_CLIENTES_SQL="SELECT rfc, es_recurrente, es_baja, fecha_baja FROM saas_estatus_cliente"

# Sesiones (genera uno con: python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=CAMBIA_ESTO
BASE_URL=https://bitacora.onecore.mx
COOKIE_SECURE=true

# IA (Anthropic). Sin clave, la app funciona y guarda sin revisión.
ANTHROPIC_API_KEY=
IA_MODELO=claude-sonnet-5-5
IA_MODELO_RAPIDO=claude-haiku-5-5
# Investigación profunda con búsqueda web (herramienta de servidor de Anthropic)
IA_BUSQUEDA_WEB=true
IA_HERRAMIENTA_BUSQUEDA=web_search_20250305

# Cifrado de transcripciones de sesiones con cliente. Genera una con:
# python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TRANSCRIPCIONES_CLAVE=

# Correo (Amazon SES SMTP, Microsoft 365 o el SMTP que uses)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PM virtual OneCore <pm@onecore.mx>"
# true para registrar los correos sin enviarlos (pruebas)
SMTP_DRY_RUN=true

ZONA_HORARIA=America/Mexico_City
